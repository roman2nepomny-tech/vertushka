<Window x:Class="Vertushka.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Vertushka"
        Title="Vertushka — мини" Width="360" Height="216" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" Icon="app.ico"
        FontFamily="/Fonts/#Onest" FontSize="15"
        MouseLeftButtonDown="Window_MouseDown">
  <Window.Resources>
    <Style x:Key="RoundBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="{DynamicResource Panel2}"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" CornerRadius="30" Background="{TemplateBinding Background}">
              <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.82"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.65"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Margin="6" CornerRadius="26" Background="{DynamicResource MiniBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="18,12,18,12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="NameText" Foreground="{DynamicResource Text}" FontSize="17" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ничего не играет"/>
        <TextBlock x:Name="RemainText" Grid.Column="1" FontFamily="/Fonts/#Unbounded" FontSize="22" Foreground="{DynamicResource Accent}" Margin="12,0,0,0" Text="0:00"/>
      </Grid>
      <v:WaveformControl x:Name="Wave" Grid.Row="1" Height="38" Margin="0,6,0,8"/>
      <Grid Grid.Row="2">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Style="{StaticResource RoundBtn}" Width="48" Height="48" FontSize="16" Content="&#xE892;" ToolTip="Предыдущий" Click="Prev_Click"/>
          <Button x:Name="PlayBtn" Style="{StaticResource RoundBtn}" Width="60" Height="60" FontSize="24" Margin="12,0" Background="{DynamicResource Text}" Foreground="{DynamicResource OnText}" Content="&#xE768;" ToolTip="Играть / пауза" Click="Play_Click"/>
          <Button Style="{StaticResource RoundBtn}" Width="48" Height="48" FontSize="16" Content="&#xE893;" ToolTip="Следующий" Click="Next_Click"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Button Style="{StaticResource RoundBtn}" Width="44" Height="44" FontSize="16" Background="Transparent" Foreground="{DynamicResource Text}" Content="&#xE740;" ToolTip="Открыть большое окно" Click="Expand_Click"/>
          <Button Style="{StaticResource RoundBtn}" Width="44" Height="44" FontSize="16" Background="Transparent" Foreground="{DynamicResource Text}" Content="&#xE8BB;" ToolTip="Закрыть мини-окно" Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
