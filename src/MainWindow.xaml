<Window x:Class="Vertushka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Vertushka"
        Title="Vertushka" Width="1180" Height="920" MinWidth="650" MinHeight="500"
        Background="Transparent" WindowStyle="None" FontFamily="/Fonts/#Onest" FontSize="15" Icon="app.ico"
        WindowStartupLocation="CenterScreen" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="SectionItem" TargetType="ListBoxItem">
      <Setter Property="AllowDrop" Value="True"/>
      <Setter Property="Padding" Value="14,4"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <EventSetter Event="DragEnter" Handler="Section_DragEnter"/>
      <EventSetter Event="DragOver" Handler="Section_DragOver"/>
      <EventSetter Event="DragLeave" Handler="Section_DragLeave"/>
      <EventSetter Event="Drop" Handler="Section_Drop"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" CornerRadius="16" Padding="{TemplateBinding Padding}" MinHeight="42" Background="Transparent"
                    BorderThickness="1.5" BorderBrush="Transparent">
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Ellipse Width="12" Height="12" Fill="{Binding Fill}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="Nm" Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="C" Grid.Column="2" Text="{Binding Count}" Foreground="{DynamicResource Muted}" FontSize="19" FontFamily="/Fonts/#Unbounded" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Panel2}"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Nm" Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="Tag" Value="drop"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="B" Property="Background" Value="{DynamicResource AccentDim}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TrackItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Margin" Value="0,0"/>
      <EventSetter Event="MouseDoubleClick" Handler="Track_DoubleClick"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Track_MouseDown"/>
      <EventSetter Event="PreviewMouseLeftButtonUp" Handler="Track_MouseUp"/>
      <EventSetter Event="PreviewMouseMove" Handler="Track_MouseMove"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" CornerRadius="14" Padding="14,0" Height="32" Background="Transparent" BorderThickness="1.5" BorderBrush="Transparent">
              <Grid>
                <Rectangle x:Name="Bar" Width="4" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-9,0,0,0" RadiusX="2" RadiusY="2" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                <Rectangle x:Name="LineTop" Height="3" VerticalAlignment="Top" Margin="-14,-1.5,-14,0" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                <Rectangle x:Name="LineBottom" Height="3" VerticalAlignment="Bottom" Margin="-14,0,-14,-1.5" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border x:Name="NxB" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource AccentDim}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10" Padding="10,2" Margin="8,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NextBadge}" Foreground="{DynamicResource Accent}" FontSize="14" FontWeight="SemiBold"/>
                  </Border>
                  <Grid>
                    <TextBlock x:Name="Num" Text="{Binding Num}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Ico" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" Visibility="Collapsed"/>
                  </Grid>
                  <TextBlock x:Name="Nm" Grid.Column="1" Text="{Binding Name}" Foreground="{TemplateBinding Foreground}" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Panel}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SelBorder}"/></Trigger>
              <Trigger Property="Tag" Value="above"><Setter TargetName="LineTop" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="Tag" Value="below"><Setter TargetName="LineBottom" Property="Visibility" Value="Visible"/></Trigger>
              <DataTrigger Binding="{Binding HasNext}" Value="True"><Setter TargetName="NxB" Property="Visibility" Value="Visible"/></DataTrigger>
              <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentDim}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Ico" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Nm" Property="Foreground" Value="{DynamicResource Text}"/>
                <Setter TargetName="Nm" Property="FontWeight" Value="SemiBold"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TrackCard" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Margin" Value="0,3"/>
      <EventSetter Event="MouseDoubleClick" Handler="Track_DoubleClick"/>
      <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Track_MouseDown"/>
      <EventSetter Event="PreviewMouseMove" Handler="Track_MouseMove"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="B" CornerRadius="22" Padding="6" Background="{DynamicResource Panel}" BorderThickness="2" BorderBrush="Transparent">
              <Grid>
                <Rectangle x:Name="LineTop" Height="3" VerticalAlignment="Top" Margin="-6,-9,-6,0" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                <Rectangle x:Name="LineBottom" Height="3" VerticalAlignment="Bottom" Margin="-6,0,-6,-9" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border x:Name="NxB" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource AccentDim}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="4,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NextBadge}" Foreground="{DynamicResource Accent}" FontSize="16" FontWeight="SemiBold"/>
                  </Border>
                  <Border Width="52" Height="52" CornerRadius="12" Background="{Binding CoverBrush}">
                    <Grid>
                      <TextBlock x:Name="Num" Text="{Binding Num}" FontFamily="/Fonts/#Unbounded" FontWeight="SemiBold" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Border x:Name="IcoBg" Background="#B3000000" CornerRadius="12" Visibility="Collapsed"/>
                      <TextBlock x:Name="Ico" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Nm" Text="{Binding Name}" Foreground="{TemplateBinding Foreground}" FontSize="18" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="48"/>
                    <ProgressBar x:Name="Prog" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,6,0,0" Visibility="Collapsed"
                                 Background="{DynamicResource Track}" Foreground="{DynamicResource Accent}" BorderThickness="0">
                      <ProgressBar.Template>
                        <ControlTemplate TargetType="ProgressBar">
                          <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2.5" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2.5" Background="{TemplateBinding Foreground}"/>
                          </Grid>
                        </ControlTemplate>
                      </ProgressBar.Template>
                    </ProgressBar>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Panel2}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource SelBorder}"/><Setter TargetName="B" Property="Background" Value="{DynamicResource Panel2}"/></Trigger>
              <Trigger Property="Tag" Value="above"><Setter TargetName="LineTop" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="Tag" Value="below"><Setter TargetName="LineBottom" Property="Visibility" Value="Visible"/></Trigger>
              <DataTrigger Binding="{Binding HasCover}" Value="True">
                <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding HasNext}" Value="True"><Setter TargetName="NxB" Property="Visibility" Value="Visible"/></DataTrigger>
              <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource AccentDim}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="B" Property="Effect">
                  <Setter.Value><DropShadowEffect Color="#E3D6A8" BlurRadius="22" ShadowDepth="0" Opacity="0.35"/></Setter.Value>
                </Setter>
                <Setter TargetName="Ico" Property="Visibility" Value="Visible"/>
                <Setter TargetName="IcoBg" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Prog" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Num" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Nm" Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="Nm" Property="FontSize" Value="21"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Paused}" Value="True">
                <Setter TargetName="Ico" Property="Text" Value="&#xE769;"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CapBtn" TargetType="Button">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="21">
              <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CapClose" TargetType="Button" BasedOn="{StaticResource CapBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="21">
              <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#E5232B"/><Setter Property="Foreground" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RecBtn" TargetType="ButtonBase" BasedOn="{StaticResource AccentBtn}">
      <Setter Property="Background" Value="{DynamicResource RecBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource RecText}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root" Background="{DynamicResource WinTint}">
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
      <Ellipse Width="820" Height="700" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-220,0,0">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource Blob1C}" Offset="0"/><GradientStop Color="{DynamicResource Blob1C}" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="700" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,-260,0">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource Blob2C}" Offset="0"/><GradientStop Color="{DynamicResource Blob2C}" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="760" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="320,0,0,-170">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource Blob3C}" Offset="0"/><GradientStop Color="{DynamicResource Blob3C}" Offset="0.45"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      </Ellipse>
    </Grid>

    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
<Grid Width="30" Height="30">
          <Ellipse Stroke="{DynamicResource Text}" StrokeThickness="1.6"/>
          <Ellipse Margin="7" Stroke="{DynamicResource Accent}" StrokeThickness="1.6"/>
        </Grid>
        <TextBlock Text="Vertushka" FontFamily="/Fonts/#Unbounded" FontWeight="Light" FontSize="19" VerticalAlignment="Center" Margin="10,0,18,0"/>
        <Button x:Name="EventBtn" Style="{StaticResource Flat}" Padding="16,7" FontSize="17" Click="Event_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                ToolTip="Выбрать, создать или удалить проект (свадьба, корпоратив…)">
          <TextBlock x:Name="EventText" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="20" Padding="4" VerticalAlignment="Center" Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ThemeLight" Style="{StaticResource Flat}" Content="Светлая" Tag="light" FontSize="15" Padding="14,6" Click="Theme_Click" ToolTip="Светлая тема"/>
            <Button x:Name="ThemeDark" Style="{StaticResource Flat}" Content="Тёмная" Tag="dark" FontSize="15" Padding="14,6" Margin="2,0,0,0" Click="Theme_Click" ToolTip="Тёмная тема"/>
            <Button x:Name="ThemeAuto" Style="{StaticResource Flat}" Content="Авто" Tag="auto" FontSize="15" Padding="14,6" Margin="2,0,0,0" Click="Theme_Click" ToolTip="Как в Windows"/>
          </StackPanel>
        </Border>
        <Button x:Name="SettingsBtn" Style="{StaticResource CapBtn}" Content="&#xE713;" ToolTip="Настройки, история, к играющему треку" Margin="0,0,8,0" Click="RailSet_Click"/>
        <Button x:Name="RecBtn" Style="{StaticResource RecBtn}" Content="●  Запись" MinWidth="130" Padding="18,9" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Начать / закончить запись (R)" Click="Rec_Click"/>
        <Button Style="{StaticResource CapBtn}" Content="&#xE921;" ToolTip="Свернуть" Click="Min_Click"/>
        <Button x:Name="MaxBtn" Style="{StaticResource CapBtn}" Content="&#xE922;" ToolTip="Развернуть" Click="Max_Click"/>
        <Button Style="{StaticResource CapClose}" Content="&#xE8BB;" ToolTip="Закрыть" Click="Close_Click"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Visibility="Collapsed" Margin="20,12,0,6" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="34" Padding="6,8" VerticalAlignment="Top">
      <StackPanel>
        <Button x:Name="RailNow" Style="{StaticResource IconBtn}" FontSize="18" Content="&#xE8D6;" Margin="0,2" Click="RailNow_Click" ToolTip="К играющему треку"/>
        <TextBlock Text="Играет" FontSize="15" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" Margin="0,-2,0,8"/>
        <Button x:Name="RailView" Style="{StaticResource IconBtn}" FontSize="18" Content="&#xE8FD;" Margin="0,2" Click="RailView_Click" ToolTip="Список или карточки"/>
        <TextBlock Text="Вид" FontSize="15" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" Margin="0,-2,0,8"/>
        <Button x:Name="RailHist" Style="{StaticResource IconBtn}" FontSize="18" Content="&#xE81C;" Margin="0,2" Click="RailHist_Click" ToolTip="Что играло недавно"/>
        <TextBlock Text="История" FontSize="15" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" Margin="0,-2,0,8"/>
        <Button x:Name="RailSet" Style="{StaticResource IconBtn}" FontSize="18" Content="&#xE713;" Margin="0,2" Click="RailSet_Click" ToolTip="Настройки: тема, волна, окно"/>
        <TextBlock Text="Настройки" FontSize="15" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" Margin="0,-2,0,8"/>
      </StackPanel>
    </Border>
    <Grid Grid.Column="1" Margin="14,12,20,6">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="GapCol" Width="16"/><ColumnDefinition x:Name="RightCol" Width="268"/></Grid.ColumnDefinitions>

      <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Content="+ Раздел" Margin="10,0,0,0" VerticalAlignment="Center" Click="NewSection_Click" ToolTip="Новый раздел (папка с треками)"/>
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="28" Padding="5,4" HorizontalAlignment="Left">
          <ListBox x:Name="SectionList" ItemContainerStyle="{StaticResource SectionItem}"
                   SelectionChanged="SectionList_SelectionChanged"
                   PreviewMouseRightButtonDown="List_RightClick"
                   ContextMenuOpening="SectionList_ContextMenuOpening">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          </ListBox>
        </Border>
      </DockPanel>

      <Border x:Name="NowCard" Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="24" Padding="14,8" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border x:Name="NowCover" Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Panel2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,18,0">
            <Grid>
              <Ellipse Width="30" Height="30" Stroke="{DynamicResource Text}" StrokeThickness="1.6" Opacity="0.7"/>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="СЕЙЧАС ИГРАЕТ" FontSize="15" Foreground="{DynamicResource Muted}"/>
            <TextBlock x:Name="NowText" Text="Ничего не играет" FontFamily="/Fonts/#Unbounded" FontSize="21" Margin="0,0,0,0" TextWrapping="Wrap" MaxHeight="56" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TimeText" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular" FontSize="18" Margin="0,3,0,0" Text="0:00 / 0:00"/>
            <TextBlock x:Name="NextText" Foreground="{DynamicResource Accent}" FontSize="17" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="520" HorizontalAlignment="Left"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="200">
            <TextBlock Text="ДО КОНЦА" FontSize="15" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
            <TextBlock x:Name="RemainText" Text="0:00" FontFamily="/Fonts/#Unbounded" FontWeight="Light" Typography.NumeralAlignment="Tabular" FontSize="32" HorizontalAlignment="Right" ToolTip="Сколько осталось до конца трека"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
              <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Slider x:Name="VolSlider" Width="130" Minimum="0" Maximum="1" Value="0.8" ValueChanged="Vol_Changed"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <DockPanel Grid.Row="2" Margin="4,0,0,6">
        <Button DockPanel.Dock="Right" Style="{StaticResource Flat}" Content="+ Добавить треки" VerticalAlignment="Center" Click="AddTracks_Click"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
          <Button x:Name="ViewList" Style="{StaticResource Flat}" Content="Список" Click="ViewList_Click" ToolTip="Треки строками"/>
          <Button x:Name="ViewCards" Style="{StaticResource Flat}" Content="Карточки" Margin="4,0,0,0" Click="ViewCards_Click" ToolTip="Треки карточками с обложками"/>
        </StackPanel>
        <Grid DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center">
          <TextBox x:Name="SearchBox" Tag="Поиск (Ctrl+F)" Width="190" Padding="14,9" FontSize="15" TextChanged="Search_Changed" KeyDown="Search_KeyDown" ToolTip="Поиск по названию (Ctrl+F). Esc — очистить"/>
        </Grid>
        <StackPanel>
          <TextBlock x:Name="SectionTitle" FontFamily="/Fonts/#Unbounded" FontSize="22" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="SectionInfo" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>

      <Border Grid.Row="3" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="26" Padding="8">
        <Grid>
          <ListBox x:Name="TrackList" ItemContainerStyle="{StaticResource TrackItem}" AllowDrop="True" SelectionMode="Extended"
                   VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" PreviewMouseWheel="TrackList_Wheel"
                   Drop="TrackList_Drop" DragOver="TrackList_DragOver" DragLeave="TrackList_DragLeave"
                   PreviewMouseRightButtonDown="List_RightClick"
                   ContextMenuOpening="TrackList_ContextMenuOpening"/>
          <TextBlock x:Name="EmptyHint" Text="Здесь пока пусто.&#x0A;Перетащите сюда песни из папки или нажмите «Добавить треки»."
                     Foreground="{DynamicResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="17" IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>
      </Border>

      <Grid x:Name="RightPanel" Grid.Column="2" Grid.Row="1" Grid.RowSpan="3">
      <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="26" Padding="18,16" VerticalAlignment="Top" MinHeight="220">
        <StackPanel>
          <DockPanel>
            <Button x:Name="NextClearBtn" DockPanel.Dock="Right" Style="{StaticResource Flat}" Content="Очистить" FontSize="13" Padding="10,3" Visibility="Collapsed" ToolTip="Убрать все треки из списка «Далее»" Click="NextClear_Click"/>
            <TextBlock x:Name="NextHead" Text="ДАЛЕЕ" FontSize="15" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          </DockPanel>
          <ItemsControl x:Name="NextItems" Margin="0,8,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,9">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding N}" Foreground="{DynamicResource Accent}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="16" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="NextEmpty" Text="Правый клик по треку → «Играть следующим»" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
      <StackPanel VerticalAlignment="Bottom">
        <UniformGrid x:Name="LoopLenPanel" Columns="4" Margin="0,0,0,8">
          <Button Style="{StaticResource Flat}" Tag="4" Content="4 с" FontSize="15" Padding="4,7" Margin="0,0,4,0" Click="LoopLen_Click" ToolTip="Длина петли 4 секунды"/>
          <Button Style="{StaticResource Flat}" Tag="8" Content="8 с" FontSize="15" Padding="4,7" Margin="0,0,4,0" Click="LoopLen_Click" ToolTip="Длина петли 8 секунд"/>
          <Button Style="{StaticResource Flat}" Tag="16" Content="16 с" FontSize="15" Padding="4,7" Margin="0,0,4,0" Click="LoopLen_Click" ToolTip="Длина петли 16 секунд"/>
          <Button Style="{StaticResource Flat}" Tag="32" Content="32 с" FontSize="15" Padding="4,7" Click="LoopLen_Click" ToolTip="Длина петли 32 секунды"/>
        </UniformGrid>
        <ToggleButton x:Name="LoopBtn" Style="{StaticResource Flat}" Content="Петля 8 с" FontSize="17" Padding="14,12" Margin="0,0,0,10" Click="Loop_Click" MouseRightButtonUp="Loop_RightClick"
                      ToolTip="Повторять кусок трека с текущего места (L). Длина — кнопками выше"/>
        <Button x:Name="DuckBtn" Style="{StaticResource AccentBtn}" Content="Поклон: приглушить" FontSize="17" FontWeight="SemiBold" Padding="14,14" Click="Duck_Click"
                ToolTip="Плавно убрать музыку, чтобы сказать в микрофон; ещё раз — вернуть (D)"/>
      </StackPanel>
      </Grid>
    </Grid>
    </Grid>

    <Border x:Name="JingleRow" Grid.Row="1" Padding="24,2,20,0" AllowDrop="True" Drop="Jingle_Drop" DragOver="TrackList_DragOver">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Громкость джинглов"/>
          <Slider x:Name="JingleVol" Width="110" Minimum="0" Maximum="1" Value="0.8" ValueChanged="JingleVol_Changed" ToolTip="Громкость джинглов"/>
          <Button Style="{StaticResource Flat}" Content="Стоп" Padding="12,8" Margin="14,0,0,0" Click="StopJingle_Click" ToolTip="Остановить джингл (Esc)"/>
          <Button Style="{StaticResource Flat}" Content="+ Джингл" Padding="12,8" Margin="8,0,0,0" Click="AddJingle_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Left" Text="Джинглы" FontSize="17" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <WrapPanel x:Name="JinglePanel" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <Border x:Name="Plate" Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="32" Margin="16,4,16,12" Padding="22,12,22,8">
      <Grid>
      <Grid x:Name="FullPanel">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Button Grid.RowSpan="4" Panel.ZIndex="5" Width="60" Height="14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-10,0,0" Cursor="Hand" Focusable="False" ToolTip="Свернуть плеер в узкую полосу, чтобы список треков был виден целиком (M)" Click="Collapse_Click">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="B" CornerRadius="5" Background="{DynamicResource Panel2}">
                <Rectangle Width="30" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Muted}" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>

        <StackPanel Grid.Row="0">
        <Border x:Name="TrimBar" Visibility="Collapsed" Margin="0,12,0,0" Background="{DynamicResource AccentDim}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="16" Padding="12,6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Style="{StaticResource Flat}" Background="{DynamicResource Hover}" Content="Приблизить" FontSize="16" Padding="14,10" Margin="0,0,8,0" Click="ZoomIn_Click" ToolTip="Показать волну крупнее (колесо мыши по приближенной волне)"/>
              <Button Style="{StaticResource Flat}" Background="{DynamicResource Hover}" Content="Отдалить" FontSize="16" Padding="14,10" Margin="0,0,14,0" Click="ZoomOut_Click" ToolTip="Показать больший кусок трека"/>
              <Button x:Name="StartBtn" Style="{StaticResource Flat}" Background="{DynamicResource AccentDim}" Content="Начало" FontSize="18" FontWeight="SemiBold" Padding="18,10" Margin="0,0,8,0" Click="TrimStart_Click" ToolTip="Поставить начало трека в этом месте"/>
              <Button x:Name="EndBtn" Style="{StaticResource Flat}" Background="{DynamicResource AccentDim}" Content="Конец" FontSize="18" FontWeight="SemiBold" Padding="18,10" Margin="0,0,14,0" Click="TrimEnd_Click" ToolTip="Поставить конец трека в этом месте"/>
              <Button Style="{StaticResource Flat}" Background="{DynamicResource Hover}" Content="Сбросить обрезку" FontSize="16" Padding="14,10" Margin="0,0,8,0" Click="TrimReset_Click" ToolTip="Вернуть трек целиком"/>
              <Button Style="{StaticResource AccentBtn}" Content="Готово" FontSize="18" Padding="20,10" Click="TrimDone_Click" ToolTip="Закончить обрезку: дальше трек играет от начала до конца"/>
            </StackPanel>
            <Border Background="{DynamicResource Accent}" CornerRadius="12" Padding="14,7" VerticalAlignment="Center" HorizontalAlignment="Left">
              <TextBlock Text="РЕЖИМ ОБРЕЗКИ" Foreground="{DynamicResource OnAccent}" FontSize="15" FontWeight="SemiBold"/>
            </Border>
            <TextBlock x:Name="TrimHint" Visibility="Collapsed"/>
          </DockPanel>
        </Border>
        <Border x:Name="ZoomBox" Visibility="Collapsed" Margin="0,8,0,0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16" Padding="6,4">
          <v:WaveformControl x:Name="ZoomWave" Height="100" ShowAxis="True" ShowBubble="False" ToolTip="Приближенная волна: нажмите, чтобы перемотать в точное место. Колесо мыши — приблизить / отдалить"/>
        </Border>
        </StackPanel>

        <Border x:Name="FullWaveHost" Grid.Row="1" Margin="0,8,0,0">
          <v:WaveformControl x:Name="Wave" Height="88" ShowAxis="True" ToolTip="Нажмите на волну, чтобы перемотать"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconBtn}" Width="40" Height="40" Content="&#xE892;" ToolTip="Предыдущий (B)" Click="Prev_Click"/>
            <Button x:Name="PlayBtn" Style="{StaticResource BigPlay}" Width="56" Height="56" FontSize="24" Content="&#xE768;" ToolTip="Играть / пауза (пробел)" Margin="8,0" Click="Play_Click"/>
            <Button Style="{StaticResource IconBtn}" Width="40" Height="40" Content="&#xE893;" ToolTip="Следующий (N)" Margin="2,0,0,0" Click="Next_Click"/>
            <Button Style="{StaticResource IconBtn}" Width="40" Height="40" Content="&#xE71A;" ToolTip="Стоп" Margin="14,0,0,0" Click="Stop_Click"/>
            <Button Style="{StaticResource Flat}" Content="Плавная пауза" FontSize="15" Padding="14,8" Margin="10,0,0,0" ToolTip="Плавно убрать звук и поставить на паузу (F)" Click="FadePause_Click"/>
          </StackPanel>
          <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{DynamicResource Text}" FontSize="20" VerticalAlignment="Center" Margin="22,0" TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PreviewBtn" Style="{StaticResource Flat}" Content="Послушать" FontSize="15" Padding="13,7" Margin="0,0,8,0" Click="Preview_Click" ToolTip="Послушать в наушниках то, что заиграет следующим (зал не слышит). Выход — в меню ⚙ → «Наушники»"/>
            <Button x:Name="TrimBtn" Style="{StaticResource Flat}" Content="Обрезка" FontSize="15" Padding="13,7" Margin="0,0,8,0" Click="Trim_Click" ToolTip="Обрезка трека: включите трек, нажмите «Начало» и «Конец» там, где нужно. Файл не меняется"/>
            <Button Style="{StaticResource Flat}" Content="Метка" FontSize="15" Padding="13,7" Margin="0,0,8,0" Click="Cue_Click" ToolTip="Поставить метку в этом месте (до 4). Прыжок — F1…F4 или клик по флажку на волне, убрать — правый клик по флажку. Shift+F1…F4 — поставить на нужный номер"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="0,6,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="MicBtn" Style="{StaticResource Flat}" Content="Микрофон" FontSize="14" Padding="11,6" ToolTip="Какой микрофон использовать" Click="Mic_Click"/>
            <ToggleButton x:Name="MusicTgl" Style="{StaticResource Flat}" Content="Писать и музыку" FontSize="14" Padding="11,6" Margin="8,0,0,0" ToolTip="Включено: в запись попадёт и голос, и то, что играет. Выключено: только микрофон." Click="MusicTgl_Click"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <ToggleButton x:Name="FadeTgl" Style="{StaticResource Flat}" Content="Затухание в конце" FontSize="14" Padding="11,6" IsChecked="True" Click="FadeTgl_Click" ToolTip="Включено: в конце каждого трека он плавно затихает, а следующий так же плавно нарастает. Выключено: резкая смена."/>
            <Slider x:Name="FadeSlider" Width="90" Margin="10,0,0,0" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="6" ValueChanged="Fade_Changed" ToolTip="За сколько секунд до конца трека начинается затухание"/>
            <TextBlock x:Name="FadeText" Foreground="{DynamicResource Muted}" FontSize="17" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40" Text="6 с"/>
            <Rectangle Width="1" Height="26" Fill="{DynamicResource Line}" Margin="14,0,4,0"/>
            <Button x:Name="WaveStyleBtn" Style="{StaticResource Flat}" Content="Волна" FontSize="14" Padding="11,6" Margin="8,0,0,0" ToolTip="Вид волны: заливка или столбики" Click="WaveStyle_Click"/>
            <Button x:Name="MiniBtn" Style="{StaticResource Flat}" Content="Мини-окно" FontSize="14" Padding="11,6" Margin="10,0,0,0" ToolTip="Маленькое окошко поверх всех программ (W)" Click="Mini_Click"/>
            <ToggleButton x:Name="TopTgl" Style="{StaticResource Flat}" Content="Поверх окон" FontSize="14" Padding="11,6" Margin="10,0,0,0" IsChecked="True" ToolTip="Окно всегда сверху и не прячется" Click="Top_Click"/>
          </StackPanel>
        </Grid>
      </Grid>

      <Grid x:Name="MiniPanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="MiniPlay" Style="{StaticResource MiniPlay}" Content="&#xE768;" ToolTip="Играть / пауза (пробел)" Click="Play_Click"/>
        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
          <TextBlock x:Name="MiniNow" Text="Ничего не играет" FontFamily="/Fonts/#Unbounded" FontSize="24" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="MiniInfo" FontSize="14" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
        </StackPanel>
        <Border x:Name="MiniWaveHost" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0"/>
        <TextBlock x:Name="MiniRemain" Grid.Column="3" Text="0:00" FontFamily="/Fonts/#Unbounded" Typography.NumeralAlignment="Tabular" FontSize="32" MinWidth="100" VerticalAlignment="Center" ToolTip="Сколько осталось до конца трека"/>
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconBtn}" Content="&#xE893;" ToolTip="Следующий (N)" Margin="8,0,0,0" Click="Next_Click"/>
          <Button Style="{StaticResource IconBtn}" Content="&#xE70E;" ToolTip="Развернуть плеер (M)" Margin="4,0,0,0" Click="Collapse_Click"/>
        </StackPanel>
      </Grid>
      </Grid>
    </Border>
    </Grid>
  </Grid>
</Window>
